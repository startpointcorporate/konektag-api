# Supply values through the environment or an ignored .env file. No real secrets belong in Git.
# Required by Node runtime and routes; point to the existing platform, never a new database.
DATABASE_URL=
REDIS_URL=
API_PUBLIC_URL=
PUBLIC_SITE_URL=
ERPNEXT_URL=
FRAPPE_API_KEY=
FRAPPE_API_SECRET=
KEYCLOAK_BASE_URL=
KEYCLOAK_REALM=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_ADMIN_CLIENT_ID=
KEYCLOAK_ADMIN_CLIENT_SECRET=
DATA_ENCRYPTION_KEY=
INTERNAL_API_TOKEN=
# In production, set APP_VERSION to the full image Git SHA.
# APP_VERSION=
# MCP: separate configuration per process, not shared OAuth client credentials.
# MCP_PUBLIC_URL=
# OAUTH_AUTHORIZE_URL=
# OAUTH_TOKEN_URL=
# OAUTH_CLIENT_ID=
# OAUTH_CLIENT_SECRET=
# OAUTH_JWKS_URI=
# OAUTH_ISSUER=
# OAUTH_AUDIENCE=
# OAUTH_STORE_DIR=
# See docs/environment-variables.json for the complete operation-specific inventory.
