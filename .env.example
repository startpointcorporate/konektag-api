# Supply values through the environment or an ignored .env file. No real secrets belong in Git.
# Required by Node runtime and routes; point to the existing platform, never a new database.
DATABASE_URL=
REDIS_URL=
API_PUBLIC_URL=
PUBLIC_SITE_URL=
ERPNEXT_URL=
FRAPPE_API_KEY=
FRAPPE_API_SECRET=
KEYCLOAK_BASE_URL=
KEYCLOAK_REALM=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_ADMIN_CLIENT_ID=
KEYCLOAK_ADMIN_CLIENT_SECRET=
DATA_ENCRYPTION_KEY=
INTERNAL_API_TOKEN=
# In production, set APP_VERSION to the full image Git SHA.
# APP_VERSION=
# MCP: separate configuration per process, not shared OAuth client credentials.
# MCP_PUBLIC_URL=
# OAUTH_AUTHORIZE_URL=
# OAUTH_TOKEN_URL=
# OAUTH_CLIENT_ID=
# OAUTH_CLIENT_SECRET=
# OAUTH_JWKS_URI=
# OAUTH_ISSUER=
# OAUTH_AUDIENCE=
# OAUTH_STORE_DIR=
# See docs/environment-variables.json for the complete operation-specific inventory.

# Marketplace transactions (API #25). Public slug -> capability -> Frappe site key.
# The browser never sees these values. One dedicated service user per site, with
# only the rights listed in docs/marketplace-transactions.md.
MARKETPLACE_TRANSACTION_MERCHANTS={"resto-demo":{"restaurant":{"site":"RESTODEMO","posProfile":"<POS Profile>","orderType":"Takeaway","channel":"Konektag"}},"hotel-demo":{"hotel":{"site":"HOTELDEMO","currency":"XAF","timezone":"Africa/Brazzaville","externalReferenceField":"konektag_reference"}}}
MARKETPLACE_FRAPPE_RESTODEMO_URL=https://restodemo.konektag.eu/
MARKETPLACE_FRAPPE_RESTODEMO_API_KEY=
MARKETPLACE_FRAPPE_RESTODEMO_API_SECRET=
MARKETPLACE_FRAPPE_HOTELDEMO_URL=https://hoteldemo.konektag.eu/
MARKETPLACE_FRAPPE_HOTELDEMO_API_KEY=
MARKETPLACE_FRAPPE_HOTELDEMO_API_SECRET=
