{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {
    "name": "konektag-api-setup",
    "namespace": "konektag-api",
    "labels": {
      "app.kubernetes.io/name": "konektag-api-setup",
      "app.kubernetes.io/component": "build"
    }
  },
  "spec": {
    "restartPolicy": "Never",
    "automountServiceAccountToken": false,
    "nodeSelector": {
      "kubernetes.io/hostname": "konektag-clients"
    },
    "volumes": [
      {
        "name": "application",
        "persistentVolumeClaim": {
          "claimName": "konektag-api-code"
        }
      }
    ],
    "containers": [
      {
        "name": "setup",
        "image": "docker.io/library/node@sha256:c86ecead9e55a5210ac1727de38a4ca840bf03dcaf34dc9749addbf383b1920c",
        "command": [
          "sleep",
          "7200"
        ],
        "volumeMounts": [
          {
            "mountPath": "/app",
            "name": "application"
          }
        ]
      }
    ]
  }
}
