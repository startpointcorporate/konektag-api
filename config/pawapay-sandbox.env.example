# Test-instance profile while onboarding is pending. Example only: no deployment.
# Enable ONLY after verifying isolation documented in docs/pawapay-sandbox.md.
PAWAPAY_ALLOW_SANDBOX=true
NODE_ENV=test
DATABASE_URL=postgres://localhost:5432/konektag_test
API_PUBLIC_URL=https://api.sandbox.konektag.eu
PUBLIC_SITE_URL=https://web.sandbox.konektag.eu
ERPNEXT_URL=https://erpnext.sandbox.konektag.eu
KTG_CG_PAWAPAY_SANDBOX_API_URL=https://api.sandbox.pawapay.io
# Inject KTG_CG_PAWAPAY_SANDBOX_API_TOKEN from the test secret store, never Git.
# The example hosts require dedicated test resources; they are not provisioned here.
